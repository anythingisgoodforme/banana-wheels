{
  "name": "banana-wheels",
  "version": "1.0.0",
  "description": "First-person JavaScript canvas game prototype with lightweight repo tooling",
  "main": "index.js",
  "scripts": {
    "start": "npm run build && http-server ./dist -p 8000 -o",
    "serve": "npm run build && http-server ./dist -p 8000",
    "bassline:demo": "node scripts/bassline-rookie-api.js",
    "dev": "live-server public --port=8000 --mount=/games:games",
    "lint": "eslint \"public/**/*.js\" \"games/**/*.js\"",
    "lint:fix": "eslint \"public/**/*.js\" \"games/**/*.js\" --fix",
    "format": "prettier --write \"public/**/*.js\" \"public/**/*.html\" \"public/**/*.css\" \"games/**/*.js\" \"games/**/*.html\" \"games/**/*.css\" \"*.json\" \"*.md\" \".github/WORKFLOWS.md\" \"docs/GAME_SPEC.md\" \"docs/NEW_GAME_PROMPT.md\"",
    "format:check": "prettier --check \"public/**/*.js\" \"public/**/*.html\" \"public/**/*.css\" \"games/**/*.js\" \"games/**/*.html\" \"games/**/*.css\" \"*.json\" \"*.md\" \".github/WORKFLOWS.md\" \"docs/GAME_SPEC.md\" \"docs/NEW_GAME_PROMPT.md\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "node scripts/build-site.js",
    "pre-commit": "npm run lint:fix && npm run format"
  },
  "keywords": [
    "javascript",
    "games",
    "learning",
    "game-development"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "live-server": "^1.2.2",
    "prettier": "^3.2.5",
    "http-server": "^14.1.1"
  },
  "dependencies": {}
}
